// Every adjacent pair cancels; the circuit is the identity.
qubit[2] q;
h q[0];
h q[0];
s q[1];
sdg q[1];
cx q[0], q[1];
cx q[0], q[1];
cz q[0], q[1];
cz q[1], q[0];
x q[0];
x q[0];
t q[1];
tdg q[1];
